load("@rules_proto_grpc_rust//:defs.bzl", "rust_grpc_library")
load("@rules_rust//rust:defs.bzl", "rust_binary")

rust_grpc_library(
    name = "routeguide_grpc",
    declared_proto_packages = ["routeguide"],
    protos = ["@rules_proto_grpc_example_protos//:routeguide_proto"],
)

rust_binary(
    name = "client",
    srcs = ["client.rs"],
    data = ["@rules_proto_grpc_example_protos//:routeguide_features"],
    edition = "2021",
    visibility = ["//examples/routeguide:__pkg__"],
    deps = [
        ":routeguide_grpc",
        "@rules_proto_grpc_rust//rust:async-stream",
        "@rules_proto_grpc_rust//rust:futures",
        "@rules_proto_grpc_rust//rust:rand",
        "@rules_proto_grpc_rust//rust:tokio",
        "@rules_proto_grpc_rust//rust:tonic",
    ],
)

rust_binary(
    name = "server",
    srcs = [
        "data.rs",
        "server.rs",
    ],
    data = ["@rules_proto_grpc_example_protos//:routeguide_features"],
    edition = "2021",
    visibility = ["//examples/routeguide:__pkg__"],
    deps = [
        ":routeguide_grpc",
        "@rules_proto_grpc_rust//rust:async-stream",
        "@rules_proto_grpc_rust//rust:futures",
        "@rules_proto_grpc_rust//rust:serde",
        "@rules_proto_grpc_rust//rust:serde_json",
        "@rules_proto_grpc_rust//rust:tokio",
        "@rules_proto_grpc_rust//rust:tokio-stream",
        "@rules_proto_grpc_rust//rust:tonic",
    ],
)
